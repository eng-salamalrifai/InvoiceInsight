<Window x:Class="InvoiceInsight.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="InvoiceInsight"
        Width="1000"
        Height="600"
        MinWidth="800"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#F5F3F9"
        FontFamily="Segoe UI"
        FlowDirection="LeftToRight">

    <Window.Resources>

        <!-- Main Color Palette -->
        <SolidColorBrush x:Key="Navy" Color="#65558F"/>
        <SolidColorBrush x:Key="PageBackground" Color="#F5F3F9"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#39334D"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#91899F"/>

        <!-- Pastel Colors -->
        <SolidColorBrush x:Key="PastelPurple" Color="#EAE4F7"/>
        <SolidColorBrush x:Key="PastelPink" Color="#F8E8F0"/>
        <SolidColorBrush x:Key="PastelTeal" Color="#E2F1EF"/>
        <SolidColorBrush x:Key="PastelPeach" Color="#F9EEDC"/>

        <!-- Navigation Style -->
        <Style x:Key="NavButton" TargetType="{x:Type RadioButton}">

            <Setter Property="Height" Value="46"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Foreground" Value="#E9E3F4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type RadioButton}">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                VerticalAlignment="Center"
                                HorizontalAlignment="Stretch"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <!-- Selected Item -->
                            <Trigger Property="IsChecked" Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#8171AC"/>

                                <Setter Property="Foreground"
                                        Value="White"/>

                            </Trigger>

                            <!-- Hover Effect -->
                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#8171AC"/>

                                <Setter Property="Foreground"
                                        Value="White"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

    </Window.Resources>


    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="245"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <!-- SIDEBAR -->
        <Border Grid.Column="0">
            <Border.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="Black" Offset="0"/>
                    <GradientStop Color="#FF65558F" Offset="0"/>
                    <GradientStop Color="#FF65558F" Offset="0"/>
                    <GradientStop Color="#FF65558F" Offset="0.378"/>
                    <GradientStop Color="#FFF3F1F8" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <DockPanel LastChildFill="True">

                <!-- Logo -->
                <StackPanel DockPanel.Dock="Top"
                            Margin="22,28,22,30">

                    <TextBlock Text="◆  Invoice Insight"
                               FontSize="21"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock Text="INVOICE MANAGEMENT"
                               FontWeight="SemiBold"
                               Foreground="#C9BDE0"
                               Margin="2,9,0,0"
                               HorizontalAlignment="Center"/>

                </StackPanel>


                <!-- Navigation -->
                <StackPanel Margin="14,0">

                    <TextBlock Text="WORKSPACE"
                               Foreground="#C9BDE0"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Margin="14,0,0,12"/>


                    <!-- Dashboard -->
                    <RadioButton x:Name="DashboardNav"
                                 GroupName="Navigation"
                                 Style="{StaticResource NavButton}"
                                 IsChecked="True"
                                 Checked="Dashboard_Checked">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="▦"
                                       FontSize="18"
                                       Width="30"/>

                            <TextBlock Text="Dashboard"/>

                        </StackPanel>

                    </RadioButton>


                    <!-- Invoices -->
                    <RadioButton x:Name="InvoicesNav"
                                 GroupName="Navigation"
                                 Style="{StaticResource NavButton}"
                                 Checked="Invoices_Checked">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="▤"
                                       FontSize="18"
                                       Width="30"/>

                            <TextBlock Text="Invoices"/>

                        </StackPanel>

                    </RadioButton>


                    <!-- Suppliers -->
                    <RadioButton x:Name="SuppliersNav"
                                 GroupName="Navigation"
                                 Style="{StaticResource NavButton}"
                                 Checked="Suppliers_Checked">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="▣"
                                       FontSize="18"
                                       Width="30"/>

                            <TextBlock Text="Suppliers"/>

                        </StackPanel>

                    </RadioButton>


                    <!-- Alerts -->
                    <RadioButton x:Name="AlertsNav"
                                 GroupName="Navigation"
                                 Style="{StaticResource NavButton}"
                                 Checked="Alerts_Checked">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="♢"
                                       FontSize="18"
                                       Width="30"/>
                            <TextBlock Width="145" Text="Import Invoices"/>

                        </StackPanel>

                    </RadioButton>

                </StackPanel>

            </DockPanel>

        </Border>



        <!-- MAIN AREA -->
        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="76"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <!-- HEADER -->
            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="#EAE5F0"
                    BorderThickness="0,0,0,1">

                <Grid Margin="30,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>


                    <!-- Page Title -->
                    <StackPanel VerticalAlignment="Center">

                        <TextBlock x:Name="PageTitle"
                                   Text="Dashboard"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"/>

                        <TextBlock Text="Welcome back! Here's your overview."
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondary}"
                                   Margin="0,4,0,0"/>

                    </StackPanel>


                    <!-- Header Actions -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">


                        <!-- Notification Button -->
                        <Button Content="♧"
                                FontSize="20"
                                Width="42"
                                Height="42"
                                Background="#F0ECF7"
                                BorderThickness="0"
                                Foreground="{StaticResource TextPrimary}"/>


                        <!-- Divider -->
                        <Border Width="1"
                                Height="30"
                                Background="#EAE5F0"
                                Margin="18,0"/>


                        <!-- User Avatar -->
                        <Border Width="38"
                                Height="38"
                                CornerRadius="19"
                                Background="#EAE4F7">

                            <TextBlock Text="A"
                                       Foreground="#65558F"
                                       FontWeight="Bold"
                                       FontSize="16"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Border>


                        <!-- User Information -->
                        <StackPanel Margin="10,0,0,0"
                                    VerticalAlignment="Center">

                            <TextBlock Text="Administrator"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}"/>

                            <TextBlock Text="System User"
                                       FontSize="10"
                                       Foreground="{StaticResource TextSecondary}"/>

                        </StackPanel>

                    </StackPanel>

                </Grid>

            </Border>



            <!-- PAGE CONTENT -->
            <ContentControl x:Name="MainContent"
                Grid.Row="1"
                Margin="30"
                ClipToBounds="True"/>


        </Grid>

    </Grid>

</Window>
