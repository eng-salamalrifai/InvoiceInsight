<UserControl x:Class="InvoiceInsight.Views.SuppliersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="LeftToRight"
             Background="#F5F3F9">

    <UserControl.Resources>

        <!-- Colors -->
        <SolidColorBrush x:Key="PrimaryText" Color="#39334D"/>
        <SolidColorBrush x:Key="SecondaryText" Color="#91899F"/>
        <SolidColorBrush x:Key="Purple" Color="#65558F"/>
        <SolidColorBrush x:Key="LightPurple" Color="#EAE4F7"/>

        <!-- DataGrid Header Style -->
        <Style x:Key="DataGridHeaderStyle"
               TargetType="DataGridColumnHeader">

            <Setter Property="Background" Value="#E5E0ED"/>
            <Setter Property="Foreground" Value="#5B526D"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

        </Style>

        <!-- DataGrid Cell Style -->
        <Style x:Key="DataGridCellStyle"
               TargetType="DataGridCell">

            <Setter Property="Foreground" Value="#39334D"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

            <Style.Triggers>

                <!-- Selected Cell -->
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#39334D"/>
                </Trigger>

            </Style.Triggers>

        </Style>

        <!-- DataGrid Row Style -->
        <Style x:Key="DataGridRowStyle"
               TargetType="DataGridRow">

            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#F1EEF5"/>
            <Setter Property="Height" Value="55"/>

            <Style.Triggers>

                <!-- Hover -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F5F5F7"/>
                </Trigger>

                <!-- Selected -->
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#F0EDF5"/>
                </Trigger>

            </Style.Triggers>

        </Style>

        <!-- Center Text in DataGrid Columns -->
        <Style x:Key="CenteredTextStyle"
               TargetType="TextBlock">

            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>

        </Style>

    </UserControl.Resources>

    <ScrollViewer x:Name="PageScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel HorizontalAlignment="Stretch">

            <!-- Main Card -->
            <Border Background="White"
                    CornerRadius="14"
                    Padding="20"
                    HorizontalAlignment="Stretch">

                <StackPanel>

                    <!-- Card Header -->
                    <StackPanel Margin="0,0,0,20">

                        <TextBlock Text="Suppliers List"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryText}"/>

                        <TextBlock Text="View all suppliers and their invoice statistics"
                                   FontSize="12"
                                   Foreground="{StaticResource SecondaryText}"
                                   Margin="0,5,0,0"/>

                    </StackPanel>

                    <!-- Suppliers DataGrid -->
                    <DataGrid ItemsSource="{Binding Suppliers}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              CanUserReorderColumns="False"
                              CanUserSortColumns="True"
                              SelectionUnit="FullRow"
                              SelectionMode="Single"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              RowHeaderWidth="0"
                              Background="White"
                              BorderThickness="0"
                              RowHeight="55"
                              MinHeight="300"
                              ColumnHeaderHeight="45"
                              FontSize="13"
                              ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}"
                              CellStyle="{StaticResource DataGridCellStyle}"
                              RowStyle="{StaticResource DataGridRowStyle}"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              PreviewMouseWheel="DataGrid_PreviewMouseWheel">

                        <DataGrid.Columns>

                            <!-- Supplier Name -->
                            <DataGridTextColumn Header="Supplier Name"
                                                Binding="{Binding Name}"
                                                Width="1.2*"
                                                MinWidth="150"
                                                ElementStyle="{StaticResource CenteredTextStyle}"/>

                            <!-- Invoice Count -->
                            <DataGridTextColumn Header="Invoice Count"
                                                Binding="{Binding InvoiceCount}"
                                                Width="1*"
                                                MinWidth="120"
                                                ElementStyle="{StaticResource CenteredTextStyle}"/>

                            <!-- Total Invoice Value -->
                            <DataGridTextColumn Header="Total Invoice Value"
                                                Binding="{Binding TotalAmount, StringFormat={}{0:N2} SYR}"
                                                Width="1.4*"
                                                MinWidth="170"
                                                ElementStyle="{StaticResource CenteredTextStyle}"/>

                        </DataGrid.Columns>

                    </DataGrid>

                    <!-- Empty State -->
                    <TextBlock Text="No suppliers found"
                               FontSize="13"
                               Foreground="{StaticResource SecondaryText}"
                               HorizontalAlignment="Center"
                               Margin="0,20,0,10">

                        <TextBlock.Style>

                            <Style TargetType="{x:Type TextBlock}">

                                <Setter Property="Visibility"
                                        Value="Collapsed"/>

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding Suppliers.Count}"
                                                 Value="0">

                                        <Setter Property="Visibility"
                                                Value="Visible"/>

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </TextBlock.Style>

                    </TextBlock>

                </StackPanel>

            </Border>

        </StackPanel>

    </ScrollViewer>

</UserControl>
